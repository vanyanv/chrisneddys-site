# Google Analytics 4 measurement ID. The live property (G-9WECB13653) is the
# default in src/components/shared/Analytics.tsx, so this only needs setting to
# point a deployment at a different property.
#
# The tag refuses to fire off *.chrisneddys.com either way, so localhost and
# Vercel preview URLs stay out of the data regardless of what is set here.
NEXT_PUBLIC_GA_ID=

# Web3Forms access key for the /contact/ form. Create a free key at
# https://web3forms.com — it is emailed to you and routes submissions to that
# address only, so it is safe to ship in the bundle (and has to be, because the
# site is a static export with no server of its own to hide it behind).
#
# Without it the form still renders and validates, but submitting falls through
# to the mailto/phone fallback rather than sending.
NEXT_PUBLIC_W3F_KEY=
