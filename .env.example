# Google Analytics 4 measurement ID. G-9WECB13653 is this repo's default, set in
# src/components/shared/Analytics.tsx, so this only needs setting to point a
# deployment at a different property.
#
# UNCONFIRMED, AND IT HAS TO BE CONFIRMED BEFORE LAUNCH: the site live on
# chrisneddys.com today is the old Gatsby build, which tags through
# GTM-WQF95WC into G-QBQRJG4LSQ. Whether G-9WECB13653 is a second data stream
# on that same property, or a different property entirely, can only be answered
# in GA4 Admin. If it is a different property, shipping this default starts a
# brand-new history and orphans the old one — set NEXT_PUBLIC_GA_ID to the
# existing ID instead, or retire the old property deliberately and write down
# the cutover date.
#
# The tag refuses to fire off *.chrisneddys.com either way, so localhost and
# Vercel preview URLs stay out of the data regardless of what is set here —
# and ?ga_debug=1 cannot open that gate, it only turns on debug_mode on a host
# that was already reporting.
NEXT_PUBLIC_GA_ID=

# Web3Forms access key for the /contact/ form. Create a free key at
# https://web3forms.com — it is emailed to you and routes submissions to that
# address only, so it is safe to ship in the bundle (and has to be, because the
# site is a static export with no server of its own to hide it behind).
#
# Without it the form still renders and validates, but submitting falls through
# to the mailto/phone fallback rather than sending.
NEXT_PUBLIC_W3F_KEY=

# Neon Postgres connection string. Set this in Vercel (Production and any
# Preview that should read/write the real catalogue) and locally in
# .env.local if you want `pnpm dev` to talk to Neon instead of the local
# PGlite database.
#
# Unset: `pnpm dev` runs against a file-persisted PGlite database at
# `.pglite/` (migrated and seeded automatically), and a production build
# (`pnpm build`, CI, or a preview without this variable) falls back to the
# in-repo catalogue in `src/data/merch.ts` instead of touching a database.
DATABASE_URL=

# Signing secret for the /admin owner-session JWT. Generate one with:
# openssl rand -base64 32
AUTH_SECRET=

# Comma-separated allowlist of owner emails allowed to sign in at /admin
# (e.g. "chris@chrisneddys.com,ned@chrisneddys.com"). Ignored once the
# `owners` table has rows — those become the allowlist instead.
OWNER_EMAILS=

# Hash of the shared owner password, in `scrypt$<saltHex>$<hashHex>` format.
# Generate with: pnpm owner:password <password>
OWNER_PASSWORD_HASH=

# Vercel Blob read/write token, for uploading product photos from
# /admin/products/<id>. Create a Blob store in the Vercel dashboard (Storage
# tab) and copy its token here (and in Vercel's own env vars for deploys).
#
# Without it the admin photo-upload card is disabled with a message saying
# so — it never falls back to writing into public/.
BLOB_READ_WRITE_TOKEN=
