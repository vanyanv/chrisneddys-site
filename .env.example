# Google Analytics 4 measurement ID. The live property (G-9WECB13653) is the
# default in src/components/shared/Analytics.tsx, so this only needs setting to
# point a deployment at a different property.
#
# The tag refuses to fire off *.chrisneddys.com either way, so localhost and
# Vercel preview URLs stay out of the data regardless of what is set here.
NEXT_PUBLIC_GA_ID=
