.next/
out/
.env
.env.local

# Local PGlite database(s), file-persisted so they survive restarts:
# `.pglite/dev` for `pnpm dev`, `.pglite/e2e` for `pnpm test:e2e`
# (PGLITE_DATA_DIR, src/db/client.ts) — never the same directory.
.pglite/
.DS_Store
*.log
.vscode/
.idea/

# Local scratch: Playwright MCP captures and TS incremental cache
.playwright-mcp/
tsconfig.tsbuildinfo

# Playwright e2e (playwright.config.ts): HTML report and trace/screenshot
# output from `pnpm test:e2e`. Its database is `.pglite/e2e` above, wiped and
# reseeded by the config's webServer command.
playwright-report/
test-results/

# Claude Code agent worktrees
.claude/worktrees/
.vercel

# Carries live owner credentials in this checkout, so it is not tracked.
# The variables it documents are listed in DEPLOY.md.
.env.example
