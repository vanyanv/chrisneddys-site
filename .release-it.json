{
  "git": {
    "commitMessage": "Release ${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "push": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["pnpm typecheck", "pnpm lint", "pnpm exec vitest run"]
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "addUnreleased": true,
      "addVersionUrl": true
    }
  }
}
