{
  "name": "chrisneddys-site",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-map-base.mjs && node scripts/db-prepare.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-order-links.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "images:photos": "node scripts/build-photo-cuts.mjs",
    "images:art": "node scripts/build-art-photos.mjs",
    "icons:favicon": "node scripts/build-favicon.mjs",
    "images:shop": "node scripts/build-shop-images.mjs --in assets/shop/foam-trucker-blue --out public/shop/foam-trucker-blue",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-prepare.mjs migrate",
    "db:seed": "node scripts/db-prepare.mjs seed",
    "db:studio": "drizzle-kit studio",
    "owner:password": "node scripts/owner-password.mjs",
    "release": "release-it",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.5",
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "next": "^15.5.25",
    "openai": "^7.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@release-it/keep-a-changelog": "^8.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.4.1",
    "release-it": "^21.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.0",
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
